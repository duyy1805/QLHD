# ERP/WMS Z76 - API test
# Cập nhật URL và dữ liệu test trước khi chạy.
# Đặt API_KEY trong .env của HTTP client; không ghi khóa thật vào file request.

@host = https://nodeapi.z76.vn
@erpPrefix = erp-test
@erpBaseUrl = {{host}}/{{erpPrefix}}
@apiKey = {{$dotenv API_KEY}}

@wmsBaseUrl = https://z76-local.vercel.app/api/share

# App kho cầu trục gọi PUT này khi xác nhận nhập. Đổi sang khotm để dùng DB chính.
@khoTmBaseUrl = http://localhost:5000/khotmtest

# Dữ liệu test
@inboundOrderId = 256974
@inboundOrderCode = PNBTP-2026-07-1827
@inboundPallet1 = BTP0000000173
@inboundPallet2 = BTP0000000174
@inboundPalletFailed = BTP0000000175

@outboundOrderId = 327199
@outboundOrderCode = PXBTP-2026-07-2644
@outboundItemCode = 40217955.M
@outboundItemName = San pham BTP
@outboundLot = 4
@outboundLot2 = 05
@outboundRequestedQuantity = 3672
@outboundLot1RequestedQuantity = 1000
@outboundLot2RequestedQuantity = 2672
@outboundPallet1 = BP0000556913
@outboundPallet2 = BP0000556710
@outboundPallet3 = BP0000556712
@outboundPallet4 = BP0000556713
@outboundPallet5 = BP0000556910
@outboundPallet6 = BP0000556709
@outboundPallet7 = BP0000556909

@currentLocationId = 21924
@targetLocationId = 21925
@targetLocationCode = DDD
@notFoundOrderId = 2147483647
@notFoundPallet = PALLET-NOT-FOUND


# A. API ERP

### A01 - Danh sách phiếu nhập, trang đầu
# Expected: 200; trả data, page, pageSize, count.
GET {{erpBaseUrl}}/wms/inbound-orders?page=0&pageSize=100
Accept: application/json

### A02 - Danh sách phiếu nhập, lọc theo số phiếu
# Expected: 200; chỉ trả các phiếu khớp soPhieu.
GET {{erpBaseUrl}}/wms/inbound-orders?page=0&pageSize=20&soPhieu={{inboundOrderCode}}
Accept: application/json

### A03 - Danh sách phiếu nhập, kiểm tra giới hạn pageSize tối đa 500
# Expected: 200; pageSize trong response là 500.
GET {{erpBaseUrl}}/wms/inbound-orders?page=0&pageSize=9999
Accept: application/json

### A04 - Xem payload nhập kho theo ID
# Expected: 200; kiểm tra pallets[].items[].Lot và quantity.
GET {{erpBaseUrl}}/wms/inbound-orders/{{inboundOrderId}}
Accept: application/json

### A05 - ID phiếu nhập không hợp lệ
# Expected: 400.
GET {{erpBaseUrl}}/wms/inbound-orders/abc
Accept: application/json

### A06 - Không tìm thấy phiếu nhập
# Expected: 404.
GET {{erpBaseUrl}}/wms/inbound-orders/{{notFoundOrderId}}
Accept: application/json

### A07 - Xem payload xuất kho theo ID
# Expected: 200; kiểm tra items[].lot có đúng LOT trong ERP.
GET {{erpBaseUrl}}/wms/outbound-orders/{{outboundOrderId}}
Accept: application/json
x-api-key: {{apiKey}}

### A08 - Payload xuất kho thiếu API key
# Expected: 401.
GET {{erpBaseUrl}}/wms/outbound-orders/{{outboundOrderId}}
Accept: application/json

### A09 - Payload xuất kho sai API key
# Expected: 403.
GET {{erpBaseUrl}}/wms/outbound-orders/{{outboundOrderId}}
Accept: application/json
x-api-key: INVALID_API_KEY

### A10 - ID phiếu xuất không hợp lệ
# Expected: 400.
GET {{erpBaseUrl}}/wms/outbound-orders/abc
Accept: application/json
x-api-key: {{apiKey}}

### A11 - Không tìm thấy phiếu xuất
# Expected: 404.
GET {{erpBaseUrl}}/wms/outbound-orders/{{notFoundOrderId}}
Accept: application/json
x-api-key: {{apiKey}}


# B. ERP -> WMS

### B00 - Xem kết quả tự gửi nhập kho sau khi xác nhận trên app
# Chỉ dùng để kiểm tra/truyền lại; B01 bên dưới là POST WMS thủ công.
GET {{khoTmBaseUrl}}/btp/phieunhap/{{inboundOrderId}}/wms-inbound
x-api-key: {{apiKey}}

### B00a - Gửi lại phiếu nhập đã lưu nếu lần gửi trước FAILED
POST {{khoTmBaseUrl}}/btp/phieunhap/{{inboundOrderId}}/gui-lai-wms
x-api-key: {{apiKey}}

### B01 - POST /api/share/wmsInbound: ERP gửi phiếu nhập sang WMS
# Theo Swagger z76-local: thay dữ liệu mẫu nếu muốn gửi phiếu nhập khác.
# Expected: 202 nếu WMS tiếp nhận.
POST {{wmsBaseUrl}}/wmsInbound
Content-Type: application/json

{
  "orderID": "{{inboundOrderId}}",
  "orderCode": "{{inboundOrderCode}}",
  "orderType": "INBOUND",
  "date": "2026-09-23T08:00:00.000Z",
  "pallets": [
    {
      "palletID": "{{inboundPallet1}}",
      "items": [
        {
          "itemCode": "9018775",
          "itemName": "Dimpa 65",
          "Lot": "LSX002",
          "quantity": 100
        },
        {
          "itemCode": "90187853",
          "itemName": "Dimpa 75",
          "Lot": "LSX003",
          "quantity": 50
        }
      ]
    },
    {
      "palletID": "{{inboundPallet2}}",
      "items": [
        {
          "itemCode": "9018775",
          "itemName": "Dimpa 65",
          "Lot": "LSX002",
          "quantity": 80
        }
      ]
    }
  ]
}

### B02 - Gửi phiếu nhập sai payload: thiếu Lot
# Expected: 400.
POST {{wmsBaseUrl}}/wmsInbound
Content-Type: application/json

{
  "orderID": "{{inboundOrderId}}",
  "orderCode": "{{inboundOrderCode}}",
  "orderType": "INBOUND",
  "date": "2026-09-23T08:00:00.000Z",
  "pallets": [
    {
      "palletID": "{{inboundPallet1}}",
      "items": [
        {
          "itemCode": "9018775",
          "itemName": "Dimpa 65",
          "quantity": 100
        }
      ]
    }
  ]
}

### B03 - POST /api/share/wmsOutbound: ERP gửi phiếu xuất sang WMS
# Theo Swagger z76-local: items[].lot là tùy chọn; mẫu này có LOT.
# Expected: 202 nếu WMS tiếp nhận.
POST {{wmsBaseUrl}}/wmsOutbound
Content-Type: application/json

{
  "orderID": "{{outboundOrderId}}",
  "orderCode": "{{outboundOrderCode}}",
  "orderType": "OUTBOUND",
  "date": "2026-09-23T08:30:00.000Z",
  "items": [
    {
      "itemCode": "{{outboundItemCode}}",
      "itemName": "{{outboundItemName}}",
      "lot": "{{outboundLot}}",
      "quantity": {{outboundRequestedQuantity}}
    }
  ]
}

### B04 - Gửi phiếu xuất không có LOT
POST {{wmsBaseUrl}}/wmsOutbound
Content-Type: application/json

{
  "orderID": "{{outboundOrderId}}",
  "orderCode": "{{outboundOrderCode}}",
  "orderType": "OUTBOUND",
  "date": "2026-09-23T08:30:00.000Z",
  "items": [
    {
      "itemCode": "{{outboundItemCode}}",
      "itemName": "{{outboundItemName}}",
      "quantity": {{outboundRequestedQuantity}}
    }
  ]
}

### B05 - Đồng bộ tồn kho với WMS
GET {{wmsBaseUrl}}/syncData
Content-Type: application/json

{
  "items": [
    {
      "itemCode": "{{outboundItemCode}}",
      "itemName": "{{outboundItemName}}",
      "quantity": {{outboundRequestedQuantity}},
      "lastUpdated": "2026-09-23T09:00:00.000Z"
    }
  ]
}


# C. WMS -> ERP - Callback nhập kho

### C01 - Nhập kho hoàn tất toàn bộ
# Expected: 200; success=true.
POST {{erpBaseUrl}}/wms/inbound-callback
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "orderID": "{{inboundOrderId}}",
  "orderCode": "{{inboundOrderCode}}",
  "orderType": "INBOUND",
  "status": "COMPLETED",
  "message": "Inbound completed",
  "processedAt": "2026-09-23T10:00:00.000Z",
  "pallets": [
    {
      "palletID": "{{inboundPallet1}}",
      "status": "COMPLETED",
      "locationID": {{currentLocationId}},
      "locationCode": "{{targetLocationCode}}"
    }
  ]
}

### C02 - Gửi lại callback nhập giống hệt để kiểm tra idempotent
# Expected: 200; không tạo thêm lịch sử nếu kiện đã ở đúng vị trí.
POST {{erpBaseUrl}}/wms/inbound-callback
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "orderID": "{{inboundOrderId}}",
  "orderCode": "{{inboundOrderCode}}",
  "orderType": "INBOUND",
  "status": "COMPLETED",
  "message": "Retry inbound completed",
  "processedAt": "2026-09-23T10:01:00.000Z",
  "pallets": [
    {
      "palletID": "{{inboundPallet1}}",
      "status": "COMPLETED",
      "locationID": {{currentLocationId}},
      "locationCode": "{{targetLocationCode}}"
    }
  ]
}

### C03 - Nhập kho thành công một phần
# Expected: 200; chỉ kiện COMPLETED được cập nhật vị trí.
POST {{erpBaseUrl}}/wms/inbound-callback
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "orderID": "{{inboundOrderId}}",
  "orderCode": "{{inboundOrderCode}}",
  "orderType": "INBOUND",
  "status": "PARTIAL",
  "message": "One pallet completed, one pallet failed",
  "processedAt": "2026-09-23T10:05:00.000Z",
  "pallets": [
    {
      "palletID": "{{inboundPallet1}}",
      "status": "COMPLETED",
      "locationID": {{currentLocationId}},
      "locationCode": "{{targetLocationCode}}"
    },
    {
      "palletID": "{{inboundPalletFailed}}",
      "status": "FAILED",
      "locationID": null,
      "locationCode": null,
      "errorCode": "NO_AVAILABLE_LOCATION",
      "message": "Không còn vị trí phù hợp"
    }
  ]
}

### C04 - Nhập kho thất bại toàn bộ
# Expected: 200; không cập nhật vị trí.
POST {{erpBaseUrl}}/wms/inbound-callback
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "orderID": "{{inboundOrderId}}",
  "orderCode": "{{inboundOrderCode}}",
  "orderType": "INBOUND",
  "status": "FAILED",
  "message": "Inbound order processing failed",
  "processedAt": "2026-09-23T10:10:00.000Z",
  "pallets": [
    {
      "palletID": "{{inboundPallet1}}",
      "status": "FAILED",
      "locationID": null,
      "locationCode": null,
      "errorCode": "NO_AVAILABLE_LOCATION",
      "message": "Không xác định được vị trí nhập"
    }
  ]
}

