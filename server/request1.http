# B. ERP -> WMS

### B00 - Xem kết quả tự gửi nhập kho sau khi xác nhận trên app
# Chỉ dùng để kiểm tra/truyền lại; B01 bên dưới là POST WMS thủ công.
GET {{khoTmBaseUrl}}/btp/phieunhap/{{inboundOrderId}}/wms-inbound
x-api-key: {{apiKey}}

### B00a - Gửi lại phiếu nhập đã lưu nếu lần gửi trước FAILED
POST {{khoTmBaseUrl}}/btp/phieunhap/{{inboundOrderId}}/gui-lai-wms
x-api-key: {{apiKey}}

### B00b - Lưu ý hợp đồng nhập tăng dần theo kiện
# Backend thực tế gửi cùng orderID nhiều lần, mỗi request chỉ có 1 phần tử pallets.
# Header Idempotency-Key: inbound-{orderID}-{palletID}. WMS phải cộng dồn pallet theo orderID.

### B01 - POST /api/share/wmsInbound: ERP gửi phiếu nhập sang WMS
# Theo Swagger z76-local: thay dữ liệu mẫu nếu muốn gửi phiếu nhập khác.
# Expected: 202 nếu WMS tiếp nhận.
POST {{wmsBaseUrl}}/wmsInbound
Content-Type: application/json

{
  "orderID": "{{inboundOrderId}}",
  "orderCode": "{{inboundOrderCode}}",
  "orderType": "INBOUND",
  "date": "2026-09-23T08:00:00.000Z",
  "pallets": [
    {
      "palletID": "{{inboundPallet1}}",
      "items": [
        {
          "itemCode": "9018775",
          "itemName": "Dimpa 65",
          "Lot": "LSX002",
          "quantity": 100
        },
        {
          "itemCode": "90187853",
          "itemName": "Dimpa 75",
          "Lot": "LSX003",
          "quantity": 50
        }
      ]
    },
    {
      "palletID": "{{inboundPallet2}}",
      "items": [
        {
          "itemCode": "9018775",
          "itemName": "Dimpa 65",
          "Lot": "LSX002",
          "quantity": 80
        }
      ]
    }
  ]
}

### B02 - Gửi phiếu nhập sai payload: thiếu Lot
# Expected: 400.
POST {{wmsBaseUrl}}/wmsInbound
Content-Type: application/json

{
  "orderID": "{{inboundOrderId}}",
  "orderCode": "{{inboundOrderCode}}",
  "orderType": "INBOUND",
  "date": "2026-09-23T08:00:00.000Z",
  "pallets": [
    {
      "palletID": "{{inboundPallet1}}",
      "items": [
        {
          "itemCode": "9018775",
          "itemName": "Dimpa 65",
          "quantity": 100
        }
      ]
    }
  ]
}

### B03 - POST /api/share/wmsOutbound: ERP gửi phiếu xuất sang WMS
# Theo Swagger z76-local: items[].lot là tùy chọn; mẫu này có LOT.
# Expected: 202 nếu WMS tiếp nhận.
POST {{wmsBaseUrl}}/wmsOutbound
Content-Type: application/json

{
  "orderID": "{{outboundOrderId}}",
  "orderCode": "{{outboundOrderCode}}",
  "orderType": "OUTBOUND",
  "date": "2026-09-23T08:30:00.000Z",
  "items": [
    {
      "itemCode": "{{outboundItemCode}}",
      "itemName": "{{outboundItemName}}",
      "lot": "{{outboundLot}}",
      "quantity": {{outboundRequestedQuantity}}
    }
  ]
}

### B04 - Gửi phiếu xuất không có LOT
POST {{wmsBaseUrl}}/wmsOutbound
Content-Type: application/json

{
  "orderID": "{{outboundOrderId}}",
  "orderCode": "{{outboundOrderCode}}",
  "orderType": "OUTBOUND",
  "date": "2026-09-23T08:30:00.000Z",
  "items": [
    {
      "itemCode": "{{outboundItemCode}}",
      "itemName": "{{outboundItemName}}",
      "skipLot": ["04", "05"],
      "quantity": {{outboundRequestedQuantity}}
    }
  ]
}

# B04 sử dụng skipLot để WMS loại trừ các dấu tuần trong danh sách khi tự chọn lot.
# WMS phải triển khai và xác nhận hỗ trợ trường items[].skipLot trước khi dùng thực tế.

### B04a - ERP gửi phiếu xuất cầu trục, loại trừ dấu tuần theo ItemCode
# POST body có thể dùng {"skipLot": ["04", "05"]} để áp dụng cho tất cả mã hàng.
# Ví dụ này chỉ loại trừ dấu tuần của mã {{outboundItemCode}}.
POST {{khoTmBaseUrl}}/btp/cau-truc/orders/{{outboundOrderId}}/dispatch
Content-Type: application/json

{
  "skipLot": {
    "{{outboundItemCode}}": ["04", "05"]
  }
}

### B04b - WMS xác nhận từ chối phiếu xuất vì thiếu tồn (chỉ gửi khi CHƯA xuất kiện)
# Sau callback này, ERP mở lại skipLot cho người dùng sửa và gửi lại.
# Khi gửi lại, ERP giữ Idempotency-Key: outbound-{orderID} theo hợp đồng WMS.
POST {{erpBaseUrl}}/wms/outbound-callback
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "eventID": "OUTBOUND-REJECT-{{outboundOrderId}}-1",
  "orderID": "{{outboundOrderId}}",
  "orderType": "OUTBOUND",
  "status": "REJECTED",
  "reasonCode": "INSUFFICIENT_STOCK",
  "message": "Không đủ tồn sau khi loại trừ dấu tuần"
}

### B05 - Đồng bộ tồn kho với WMS
GET {{wmsBaseUrl}}/syncData
Content-Type: application/json

{
  "items": [
    {
      "itemCode": "{{outboundItemCode}}",
      "itemName": "{{outboundItemName}}",
      "quantity": {{outboundRequestedQuantity}},
      "lastUpdated": "2026-09-23T09:00:00.000Z"
    }
  ]
}


