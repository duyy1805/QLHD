}

### G10 - Nhiều kiện/dấu tuần/dòng ERP: phiếu RIÊNG
# 200; tổng wfMultiQty1+wfMultiQty2 bằng yêu cầu ERP theo mã hàng. Chọn phiếu nhiều dòng cùng mã để kiểm tra lượng từng dòng yêu cầu được giữ nguyên.
POST {{wfErpBaseUrl}}/wms/outbound-callback
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "eventID": "{{wfEventId}}-MULTI",
  "orderID": "{{wfMultiOrderId}}",
  "orderCode": "{{wfMultiOrderCode}}",
  "orderType": "OUTBOUND",
  "status": "COMPLETED",
  "processedAt": "{{wfProcessedAt}}",
  "items": [
    {
      "itemCode": "{{wfItemCode}}",
      "lot": "{{wfLot}}",
      "requestedQuantity": {{wfMultiQty1}},
      "exportedQuantity": {{wfMultiQty1}},
      "pallets": [
        {
          "palletID": "{{wfMultiPallet1}}",
          "quantity": {{wfMultiQty1}}
        }
      ]
    },
    {
      "itemCode": "{{wfItemCode}}",
      "lot": "{{wfLot2}}",
      "requestedQuantity": {{wfMultiQty2}},
      "exportedQuantity": {{wfMultiQty2}},
      "pallets": [
        {
          "palletID": "{{wfMultiPallet2}}",
          "quantity": {{wfMultiQty2}}
        }
      ]
    }
  ]
}

# A. API ERP

### A00 - Danh sách vị trí kho cầu trục Z76
# Expected: 200; count=1976. locations[] gồm locationID, locationCode, qrCode,
# name, crane, rack, tier và position; bắt buộc x-api-key của WMS nội bộ.
GET {{erpBaseUrl}}/wms/locations
x-api-key: {{apiKey}}
Accept: application/json

### A01 - Danh sách phiếu nhập, trang đầu
# Expected: 200; trả data, page, pageSize, count.
GET {{erpBaseUrl}}/wms/inbound-orders?page=0&pageSize=100
Accept: application/json

### A02 - Danh sách phiếu nhập, lọc theo số phiếu
# Expected: 200; chỉ trả các phiếu khớp soPhieu.
GET {{erpBaseUrl}}/wms/inbound-orders?page=0&pageSize=20&soPhieu={{inboundOrderCode}}
Accept: application/json

### A03 - Danh sách phiếu nhập, kiểm tra giới hạn pageSize tối đa 500
# Expected: 200; pageSize trong response là 500.
GET {{erpBaseUrl}}/wms/inbound-orders?page=0&pageSize=9999
Accept: application/json

### A04 - Xem payload nhập kho theo ID
# Expected: 200; kiểm tra pallets[].items[].Lot và quantity.
GET {{erpBaseUrl}}/wms/inbound-orders/{{inboundOrderId}}
Accept: application/json

### A05 - ID phiếu nhập không hợp lệ
# Expected: 400.
GET {{erpBaseUrl}}/wms/inbound-orders/abc
Accept: application/json

### A06 - Không tìm thấy phiếu nhập
# Expected: 404.
GET {{erpBaseUrl}}/wms/inbound-orders/{{notFoundOrderId}}
Accept: application/json

### A07 - Xem payload xuất kho theo ID
# Expected: 200; kiểm tra items[].lot có đúng LOT trong ERP.
