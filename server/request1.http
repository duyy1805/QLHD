# ERP/WMS Z76 - API test
# Cập nhật0 URL và dữ liệu test trước khi chạy.
# Đặt API_KEY trong .env của HTTP client; không ghi khóa thật vào file request.

@host = https://nodeapi.z76.vn
@erpPrefix = erp-test
@erpBaseUrl = {{host}}/{{erpPrefix}}
@apiKey = {{$dotenv API_KEY}}

@wmsBaseUrl = https://z76-local.vercel.app/api/share

# App kho cầu trục gọi PUT này khi xác nhận nhập. Đổi sang khotm để dùng DB chính.
@khoTmBaseUrl = http://localhost:5000/khotmtest

# Dữ liệu test
@inboundOrderId = 256996
@inboundOrderCode = PN-CT-ML-261016
@inboundPallet1 = ct-multilot-261016-01
@inboundPallet2 = ct-partial-261016-02
@inboundPalletFailed = ct-retry-261016-01

@outboundOrderId = 327344
@outboundOrderCode = PX-CT-FULL-261016
@outboundItemCode = 10056770.B
@outboundItemName = DIMPA stor bag 65x22x65 transparent
@outboundLot = 2647
@outboundLot2 = 2648
@outboundRequestedQuantity = 200
@outboundLot1RequestedQuantity = 120
@outboundLot2RequestedQuantity = 80
@outboundPallet1 = ct-multilot-261016-01
@outboundPallet2 = ct-partial-261016-01
@outboundPallet3 = ct-partial-261016-02
@outboundPallet4 = ct-batch-261016-01
@outboundPallet5 = ct-batch-261016-02
@outboundPallet6 = ct-batch-261016-03
@outboundPallet7 = ct-batch-261016-04

# Bộ case mới sau khi làm sạch DB test
@inboundMultiLotId = 256996
@inboundPartialId = 256997
@inboundBatchId = 256998
@inboundRetryId = 256999
@outboundFullId = 327344
@outboundPartialId = 327345
@outboundSkipLotId = 327346

@currentLocationId = 32149
@targetLocationId = 32148
@targetLocationCode = D-3-6-01
@notFoundOrderId = 2147483647
@notFoundPallet = PALLET-NOT-FOUND


# G. WMS CHỌN KIỆN - ERP LƯU PHIẾU (LUỒNG MỚI)
# Chạy G01 -> G08; G09/G10 dùng phiếu riêng. Không dùng demoMode.
# Điền ID/mã phiếu chưa xác nhận sau G01; đọc CRANE_WMS_SETUP.md.
@wfErpBaseUrl = http://localhost:5000/erp-test
# @wfErpBaseUrl = http://localhost:5000/erp-test
@wfKhoBaseUrl = http://localhost:5000/khotmtest
@wfOrderId = 326999
@wfOrderCode = PXBTP-2026-07-2444
@wfItemCode = 4666377.B
@wfLot = 5
@wfPallet = BP0000535493
@wfReturnPallet = BP0000600001
@wfQuantity = 300
@wfShortQuantity = 299
@wfOriginalLocation = 7189
@wfTempLocation = 30302
@wfEventId = WMS-XUAT-THU-001
@wfReturnEventId = WMS-TRA-THU-001
@wfProcessedAt = 2026-09-29T08:00:00.000Z
@wfFullOrderId = 0
@wfFullOrderCode = DIEN_PHIEU_XUAT_HET
@wfFullPallet = DIEN_QR_XUAT_HET
@wfFullQuantity = 300
@wfMultiOrderId = 0
@wfMultiOrderCode = DIEN_PHIEU_NHIEU_DONG
@wfMultiPallet1 = DIEN_KIEN_1
@wfMultiPallet2 = DIEN_KIEN_2
@wfLot2 = DIEN_DAU_TUAN_2
@wfMultiQty1 = 100
@wfMultiQty2 = 200
# eventID là tùy chọn. Trước TrangThai=5, mỗi callback hợp lệ thay thế snapshot xuất hiện tại.

### G01 - Danh sách phiếu WMS còn được cập nhật
# 200; gồm phiếu chưa lưu và phiếu TrangThai=4, không gồm TrangThai=5. Có thể thêm &soPhieu=...
GET {{wfErpBaseUrl}}/wms/outbound-orders?page=0&pageSize=100
x-api-key: {{apiKey}}
Accept: application/json

### G02 - Chi tiết phiếu chưa ghi thẻ kho
# 200; qrStatus có thể false hoặc true ở TrangThai=4. Lấy QR/dấu tuần/vị trí từ scripts/check-wms-outbound.sql.
GET {{wfErpBaseUrl}}/wms/outbound-orders/{{wfOrderId}}
x-api-key: {{apiKey}}
Accept: application/json

### G03a - Payload WMS cũ không có eventID (TÙY CHỌN, chạy thay G04)
# 200; ERP vẫn lưu snapshot. Không chạy G03a nếu muốn G04 là lần lưu đầu tiên.
POST {{wfErpBaseUrl}}/wms/outbound-callback
x-api-key: {{apiKey}}
Content-Type: application/json

{
  "orderID": "{{wfOrderId}}",
  "orderCode": "{{wfOrderCode}}",
  "orderType": "OUTBOUND",
  "status": "COMPLETED",
  "processedAt": "{{wfProcessedAt}}",
  "items": [
    {
      "itemCode": "{{wfItemCode}}",
      "lot": "{{wfLot}}",
      "requestedQuantity": {{wfQuantity}},
      "exportedQuantity": {{wfQuantity}},
      "pallets": [
        {
          "palletID": "{{wfPallet}}",
          "quantity": {{wfQuantity}}
        }
      ]
    }
  ]
}

